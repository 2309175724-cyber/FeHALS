<mxGraphModel>
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <!-- Title -->
    <mxCell id="title" value="FeHALS 数据流程图"
            style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;"
            vertex="1" parent="1">
      <mxGeometry x="250" y="20" width="300" height="40" as="geometry"/>
    </mxCell>

    <!-- Swimlanes -->
    <!-- User Lane -->
    <mxCell id="user_lane" value="用户"
            style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;startSize=40;"
            vertex="1" parent="1">
      <mxGeometry x="40" y="80" width="160" height="800" as="geometry"/>
    </mxCell>

    <!-- Frontend Lane -->
    <mxCell id="frontend_lane" value="前端层\n(Vue 3 + Three.js)"
            style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;startSize=40;"
            vertex="1" parent="1">
      <mxGeometry x="220" y="80" width="220" height="800" as="geometry"/>
    </mxCell>

    <!-- Backend Lane -->
    <mxCell id="backend_lane" value="后端层\n(FastAPI + Python)"
            style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;startSize=40;"
            vertex="1" parent="1">
      <mxGeometry x="460" y="80" width="220" height="800" as="geometry"/>
    </mxCell>

    <!-- HELIOS++ Lane -->
    <mxCell id="helios_lane" value="HELIOS++ 仿真引擎"
            style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;startSize=40;"
            vertex="1" parent="1">
      <mxGeometry x="700" y="80" width="220" height="800" as="geometry"/>
    </mxCell>

    <!-- Process Steps in User Lane -->
    <mxCell id="step1" value="1. 打开浏览器&#10;访问系统"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;"
            vertex="1" parent="user_lane">
      <mxGeometry x="20" y="150" width="120" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="step2" value="2. 上传三维模型&#10;(OBJ/GLTF/STL)"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;"
            vertex="1" parent="user_lane">
      <mxGeometry x="20" y="230" width="120" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="step3" value="3. 交互式航路规划&#10;• 点击添加航点&#10;• 拖拽编辑航线"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;"
            vertex="1" parent="user_lane">
      <mxGeometry x="20" y="330" width="120" height="70" as="geometry"/>
    </mxCell>

    <mxCell id="step4" value="4. 配置仿真参数&#10;• 载体/传感器设置&#10;• 输出格式选择"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;"
            vertex="1" parent="user_lane">
      <mxGeometry x="20" y="430" width="120" height="70" as="geometry"/>
    </mxCell>

    <mxCell id="step5" value="5. 启动仿真"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;"
            vertex="1" parent="user_lane">
      <mxGeometry x="20" y="530" width="120" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="step6" value="6. 监控仿真进度&#10;• 实时日志查看&#10;• 进度条显示"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;"
            vertex="1" parent="user_lane">
      <mxGeometry x="20" y="610" width="120" height="70" as="geometry"/>
    </mxCell>

    <mxCell id="step7" value="7. 查看结果&#10;• 点云渲染&#10;• 参数调节"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;"
            vertex="1" parent="user_lane">
      <mxGeometry x="20" y="710" width="120" height="50" as="geometry"/>
    </mxCell>

    <!-- Process Steps in Frontend Lane -->
    <mxCell id="fstep1" value="加载首页&#10;初始化 Three.js 场景"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F57F17;"
            vertex="1" parent="frontend_lane">
      <mxGeometry x="20" y="150" width="180" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="fstep2" value="ModelList.vue&#10;• 文件上传&#10;• 模型预览"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F57F17;"
            vertex="1" parent="frontend_lane">
      <mxGeometry x="20" y="230" width="180" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="fstep3" value="Scene3D.vue&#10;• 模型加载&#10;• 航点交互&#10;• OrbitControls"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F57F17;"
            vertex="1" parent="frontend_lane">
      <mxGeometry x="20" y="330" width="180" height="70" as="geometry"/>
    </mxCell>

    <mxCell id="fstep4" value="ControlPanel.vue&#10;• 参数表单&#10;• 表单验证"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F57F17;"
            vertex="1" parent="frontend_lane">
      <mxGeometry x="20" y="430" width="180" height="70" as="geometry"/>
    </mxCell>

    <mxCell id="fstep5" value="发送请求&#10;POST /api/simulate"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0277BD;"
            vertex="1" parent="frontend_lane">
      <mxGeometry x="20" y="530" width="180" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="fstep6" value="WebSocket 连接&#10;/ws/{task_id}"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0277BD;"
            vertex="1" parent="frontend_lane">
      <mxGeometry x="20" y="610" width="180" height="70" as="geometry"/>
    </mxCell>

    <mxCell id="fstep7" value="LogConsole.vue&#10;• 日志显示&#10;• 进度更新"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F57F17;"
            vertex="1" parent="frontend_lane">
      <mxGeometry x="20" y="710" width="180" height="50" as="geometry"/>
    </mxCell>

    <!-- Process Steps in Backend Lane -->
    <mxCell id="bstep1" value="Main.py&#10;• 路由分发&#10;• CORS 处理"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;"
            vertex="1" parent="backend_lane">
      <mxGeometry x="20" y="150" width="180" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="bstep2" value="文件存储&#10;• 静态文件服务&#10;• 目录结构管理"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;"
            vertex="1" parent="backend_lane">
      <mxGeometry x="20" y="230" width="180" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="bstep3" value="trajectory_generator.py&#10;生成 .trj 航迹文件"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;"
            vertex="1" parent="backend_lane">
      <mxGeometry x="20" y="330" width="180" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="bstep4" value="config_generator.py&#10;生成 XML 配置文件"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;"
            vertex="1" parent="backend_lane">
      <mxGeometry x="20" y="430" width="180" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="bstep5" value="helios_service.py&#10;• 参数校验&#10;• 子进程创建"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;"
            vertex="1" parent="backend_lane">
      <mxGeometry x="20" y="530" width="180" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="bstep6" value="任务管理&#10;• 日志流捕获&#10;• 进度计算"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;"
            vertex="1" parent="backend_lane">
      <mxGeometry x="20" y="610" width="180" height="70" as="geometry"/>
    </mxCell>

    <mxCell id="bstep7" value="pointcloud_parser.py&#10;解析输出点云"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;"
            vertex="1" parent="backend_lane">
      <mxGeometry x="20" y="710" width="180" height="50" as="geometry"/>
    </mxCell>

    <!-- Process Steps in HELIOS++ Lane -->
    <mxCell id="hstep1" value="环境检查&#10;• 可执行文件验证&#10;• 资源目录检查"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0277BD;"
            vertex="1" parent="helios_lane">
      <mxGeometry x="20" y="150" width="180" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="hstep2" value="资源加载&#10;• 平台/扫描器&#10;• 场景文件"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0277BD;"
            vertex="1" parent="helios_lane">
      <mxGeometry x="20" y="230" width="180" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="hstep3" value="光线追踪仿真&#10;• 航线扫描&#10;• 激光脉冲模拟"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0277BD;"
            vertex="1" parent="helios_lane">
      <mxGeometry x="20" y="530" width="180" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="hstep4" value="结果输出&#10;• XYZ 点云&#10;• 日志文件"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0277BD;"
            vertex="1" parent="helios_lane">
      <mxGeometry x="20" y="710" width="180" height="50" as="geometry"/>
    </mxCell>

    <!-- Data Flow Arrows -->
    <!-- User to Frontend -->
    <mxCell id="arrow1" value=""
            style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#666666;strokeWidth=2;endArrow=classic;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"
            edge="1" parent="1" source="step1" target="fstep1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <mxCell id="arrow2" value=""
            style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#666666;strokeWidth=2;endArrow=classic;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"
            edge="1" parent="1" source="step2" target="fstep2">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <mxCell id="arrow3" value=""
            style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#666666;strokeWidth=2;endArrow=classic;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"
            edge="1" parent="1" source="step3" target="fstep3">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <mxCell id="arrow4" value=""
            style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#666666;strokeWidth=2;endArrow=classic;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"
            edge="1" parent="1" source="step4" target="fstep4">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Frontend to Backend -->
    <mxCell id="arrow5" value="HTTP POST"
            style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#666666;strokeWidth=2;endArrow=classic;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;"
            edge="1" parent="1" source="fstep5" target="bstep5">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Backend processes -->
    <mxCell id="arrow6" value=""
            style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#666666;strokeWidth=2;endArrow=classic;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
            edge="1" parent="1" source="bstep3" target="bstep5">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <mxCell id="arrow7" value=""
            style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#666666;strokeWidth=2;endArrow=classic;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
            edge="1" parent="1" source="bstep4" target="bstep5">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Backend to HELIOS++ -->
    <mxCell id="arrow8" value="子进程调用"
