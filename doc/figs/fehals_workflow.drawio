            edge="1" parent="1" source="bstep5" target="hstep3">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Return flows (dashed) -->
    <mxCell id="arrow9" value="日志输出"
            style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#666666;strokeWidth=2;endArrow=classic;dashed=1;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;"
            edge="1" parent="1" source="hstep3" target="bstep6">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <mxCell id="arrow10" value="WebSocket"
            style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#666666;strokeWidth=2;endArrow=classic;dashed=1;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;"
            edge="1" parent="1" source="bstep6" target="fstep6">
