<mxGraphModel>
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <!-- Title -->
    <mxCell id="title" value="FeHALS 系统架构图"
            style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;"
            vertex="1" parent="1">
      <mxGeometry x="300" y="20" width="300" height="40" as="geometry"/>
    </mxCell>

    <!-- Frontend Layer -->
    <mxCell id="frontend_layer" value="前端层\n(Vue 3 + Three.js)"
            style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;startSize=30;"
            vertex="1" parent="1">
      <mxGeometry x="40" y="80" width="700" height="280" as="geometry"/>
    </mxCell>

    <!-- Frontend Components -->
    <mxCell id="frontend_label" value="组件层"
            style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;"
            vertex="1" parent="frontend_layer">
      <mxGeometry x="20" y="40" width="100" height="20" as="geometry"/>
    </mxCell>

    <!-- View Components -->
    <mxCell id="scene3d" value="Scene3D.vue\n• Three.js 3D场景\n• 模型加载(OBJ/GLTF/STL)\n• 航点交互\n• 点云渲染"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F57F17;"
            vertex="1" parent="frontend_layer">
      <mxGeometry x="20" y="70" width="160" height="90" as="geometry"/>
    </mxCell>

    <mxCell id="controlpanel" value="ControlPanel.vue\n• 仿真参数配置\n• 载体/传感器设置\n• 输出格式选择"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F57F17;"
            vertex="1" parent="frontend_layer">
      <mxGeometry x="200" y="70" width="160" height="90" as="geometry"/>
    </mxCell>

    <mxCell id="waypointlist" value="WaypointList.vue\n• 航点管理\n• 坐标编辑\n• 批量操作"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F57F17;"
            vertex="1" parent="frontend_layer">
      <mxGeometry x="380" y="70" width="160" height="90" as="geometry"/>
    </mxCell>

    <mxCell id="logconsole" value="LogConsole.vue\n• 实时日志\n• 分级显示\n• 自动滚动"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F57F17;"
            vertex="1" parent="frontend_layer">
      <mxGeometry x="560" y="70" width="160" height="90" as="geometry"/>
    </mxCell>

    <!-- State Management -->
    <mxCell id="state_mgmt" value="状态管理 (Pinia)"
            style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;"
            vertex="1" parent="frontend_layer">
      <mxGeometry x="20" y="170" width="160" height="20" as="geometry"/>
    </mxCell>

    <mxCell id="scene_store" value="scene store\n• 模型/点云渲染\n• 场景状态"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0277BD;"
            vertex="1" parent="frontend_layer">
      <mxGeometry x="20" y="195" width="160" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="waypoints_store" value="waypoints store\n• 航点数据\n• 航线管理"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0277BD;"
            vertex="1" parent="frontend_layer">
      <mxGeometry x="200" y="195" width="160" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="simulation_store" value="simulation store\n• 任务状态\n• 进度/日志"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0277BD;"
            vertex="1" parent="frontend_layer">
      <mxGeometry x="380" y="195" width="160" height="50" as="geometry"/>
    </mxCell>

    <!-- Composables -->
    <mxCell id="composables" value="Composables"
            style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;"
            vertex="1" parent="frontend_layer">
      <mxGeometry x="560" y="170" width="160" height="20" as="geometry"/>
    </mxCell>

    <mxCell id="useThreeScene" value="useThreeScene\n• 场景管理\n• 渲染循环"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0277BD;"
            vertex="1" parent="frontend_layer">
      <mxGeometry x="560" y="195" width="160" height="50" as="geometry"/>
    </mxCell>

    <!-- API Layer -->
    <mxCell id="api_layer" value="API 层"
            style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;"
            vertex="1" parent="frontend_layer">
      <mxGeometry x="380" y="255" width="160" height="20" as="geometry"/>
    </mxCell>

    <mxCell id="heliosAPI" value="useHeliosAPI\n• REST API 客户端\n• WebSocket 连接"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0277BD;"
            vertex="1" parent="frontend_layer">
      <mxGeometry x="380" y="280" width="160" height="50" as="geometry"/>
    </mxCell>

    <!-- Backend Layer -->
    <mxCell id="backend_layer" value="后端层\n(FastAPI + Python)"
            style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;startSize=30;"
            vertex="1" parent="1">
      <mxGeometry x="40" y="380" width="700" height="280" as="geometry"/>
    </mxCell>

    <!-- Backend Components -->
    <mxCell id="api_endpoints" value="API 端点"
            style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;"
            vertex="1" parent="backend_layer">
      <mxGeometry x="20" y="40" width="100" height="20" as="geometry"/>
    </mxCell>

    <mxCell id="rest_routes" value="REST Routes\n• POST /api/upload\n• GET /api/models\n• POST /api/waypoints\n• POST /api/simulate\n• GET /api/results"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F57F17;"
            vertex="1" parent="backend_layer">
      <mxGeometry x="20" y="70" width="220" height="80" as="geometry"/>
    </mxCell>

    <mxCell id="websocket_endpoint" value="WebSocket\n• /ws/{task_id}\n• 日志推送\n• 进度更新"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F57F17;"
            vertex="1" parent="backend_layer">
      <mxGeometry x="260" y="70" width="220" height="80" as="geometry"/>
    </mxCell>

    <!-- Services -->
    <mxCell id="services_layer" value="服务层"
            style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;"
            vertex="1" parent="backend_layer">
      <mxGeometry x="260" y="160" width="220" height="20" as="geometry"/>
    </mxCell>

    <mxCell id="trajectory_service" value="trajectory_generator\n• 航迹文件生成\n• 自动航路规划"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;"
            vertex="1" parent="backend_layer">
      <mxGeometry x="20" y="190" width="220" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="config_service" value="config_generator\n• XML 配置生成\n• 参数映射"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;"
            vertex="1" parent="backend_layer">
      <mxGeometry x="260" y="190" width="220" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="helios_service" value="helios_service\n• 子进程调用\n• 日志捕获\n• 任务管理"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;"
            vertex="1" parent="backend_layer">
      <mxGeometry x="500" y="190" width="220" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="pointcloud_service" value="pointcloud_parser\n• LAS/LAZ 解析\n• XYZ 文本解析\n• 降采样"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;"
            vertex="1" parent="backend_layer">
      <mxGeometry x="260" y="250" width="220" height="50" as="geometry"/>
    </mxCell>

    <!-- Models -->
    <mxCell id="pydantic_models" value="Pydantic Models"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;"
            vertex="1" parent="backend_layer">
      <mxGeometry x="500" y="250" width="220" height="50" as="geometry"/>
    </mxCell>

    <!-- Core App -->
    <mxCell id="core_app" value="核心应用"
            style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;"
            vertex="1" parent="backend_layer">
      <mxGeometry x="20" y="310" width="220" height="20" as="geometry"/>
    </mxCell>

    <mxCell id="main_py" value="main.py\n• FastAPI 应用\n• 路由注册\n• CORS 中间件"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;"
            vertex="1" parent="backend_layer">
      <mxGeometry x="20" y="330" width="220" height="30" as="geometry"/>
    </mxCell>

    <mxCell id="config_py" value="config.py\n• 环境配置\n• HELIOS++ 路径"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;"
            vertex="1" parent="backend_layer">
      <mxGeometry x="260" y="330" width="220" height="30" as="geometry"/>
    </mxCell>

    <!-- Static Files -->
    <mxCell id="static_files" value="static/\n• 上传文件\n• 生成文件\n• 结果数据"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;"
            vertex="1" parent="backend_layer">
      <mxGeometry x="500" y="310" width="220" height="50" as="geometry"/>
    </mxCell>

    <!-- HELIOS++ Layer -->
    <mxCell id="helios_layer" value="仿真引擎层\n(HELIOS++)"
            style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;startSize=30;"
            vertex="1" parent="1">
      <mxGeometry x="40" y="680" width="700" height="180" as="geometry"/>
    </mxCell>

    <!-- HELIOS++ Components -->
    <mxCell id="helios_exe" value="helios++\n• 光线追踪引擎\n• 命令行工具\n• 子进程执行"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0277BD;"
            vertex="1" parent="helios_layer">
      <mxGeometry x="20" y="80" width="220" height="70" as="geometry"/>
    </mxCell>

    <mxCell id="helios_assets" value="资源目录\n• /platforms\n• /scanners\n• /scenes\n• /survey"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0277BD;"
            vertex="1" parent="helios_layer">
      <mxGeometry x="260" y="80" width="220" height="70" as="geometry"/>
    </mxCell>

    <mxCell id="helios_output" value="输出数据\n• XYZ (默认)\n• LAS/LAZ (可选)\n• 点云数据"
            style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0277BD;"
            vertex="1" parent="helios_layer">
      <mxGeometry x="500" y="80" width="220" height="70" as="geometry"/>
    </mxCell>

    <!-- User -->
    <mxCell id="user" value="用户"
            style="ellipse;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;"
            vertex="1" parent="1">
      <mxGeometry x="20" y="50" width="80" height="40" as="geometry"/>
    </mxCell>

    <!-- Data Flow Arrows -->
    <!-- User interaction -->
    <mxCell id="user_to_frontend" value="浏览器访问"
            style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#666666;strokeWidth=2;endArrow=classic;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;"
            edge="1" parent="1" source="user" target="frontend_layer">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Frontend to Backend -->
    <mxCell id="frontend_to_backend" value="HTTP/WS"
            style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#666666;strokeWidth=2;endArrow=classic;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;exitPerimeter=0;entryPerimeter=0;"
            edge="1" parent="1" source="frontend_layer" target="backend_layer">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Backend to HELIOS++ -->
    <mxCell id="backend_to_helios" value="子进程调用"
            style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#666666;strokeWidth=2;endArrow=classic;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;exitPerimeter=0;entryPerimeter=0;"
            edge="1" parent="1" source="backend_layer" target="helios_layer">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Return flows (dashed) -->
    <mxCell id="helios_to_backend" value="日志/结果"
            style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#666666;strokeWidth=2;endArrow=classic;dashed=1;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=10;"
            edge="1" parent="1" source="helios_layer" target="backend_layer">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <mxCell id="backend_to_frontend" value="实时推送"
            style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#666666;strokeWidth=2;endArrow=classic;dashed=1;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;"
            edge="1" parent="1" source="backend_layer" target="frontend_layer">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Legend -->
    <mxCell id="legend" value="图例说明\n→ 请求/命令流\n← 响应/结果流\n⇋ 实时双向通信\n\n技术栈：\n• 前端：Vue 3 + Three.js\n• 后端：FastAPI + Python\n• 仿真：HELIOS++\n• 通信：HTTP + WebSocket"
            style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;"
            vertex="1" parent="1">
      <mxGeometry x="760" y="880" width="180" height="100" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>